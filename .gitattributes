# Default: let git normalize text files
* text=auto

# Source and config: always LF in the repo
*.java       text eol=lf
*.fxml       text eol=lf
*.css        text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.py         text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.csv        text eol=lf
*.sh         text eol=lf

# Windows scripts need CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Images: binary, never diffed or line-ending converted
*.jpg        binary
*.jpeg       binary
*.png        binary
*.gif        binary
*.bmp        binary
*.webp       binary
*.ico        binary

# Documents
*.pdf        binary

# Models and weights
*.onnx       binary
*.pt         binary
*.pth        binary

# Build artifacts
*.jar        binary
*.zip        binary